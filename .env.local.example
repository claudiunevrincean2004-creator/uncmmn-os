NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
ANTHROPIC_API_KEY=sk-ant-...

# Slack incoming-webhook URLs (server-only; no NEXT_PUBLIC_ prefix). Each ping
# route skips silently when its webhook is unset.
SLACK_MAINIGUPDATES_WEBHOOK_URL=https://hooks.slack.com/services/...
SLACK_ADS_WEBHOOK_URL=https://hooks.slack.com/services/...
# Private finance channel — pinged when a payment reaches Ready to Pay.
# Carries a summary and a link only; never payment rails. See
# app/api/finance-notify/route.ts.
SLACK_FINANCE_WEBHOOK_URL=https://hooks.slack.com/services/...
# Dedicated Trial Reels channel (daily queue digest + In Review pings).
SLACK_TRIALREELS_WEBHOOK_URL=https://hooks.slack.com/services/...
